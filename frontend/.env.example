# =====================================================
# StudyBuddy Frontend — Environment Variables
# =====================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to Git.

# --- Backend API Base URL ---
# In development, this is handled by the Vite proxy (no change needed).
# In production, set this to your deployed Flask backend URL.
# e.g. https://studybuddy-api.onrender.com
VITE_API_BASE_URL=https://study-buddy-jwks.onrender.com
