# =====================================================
# StudyBuddy Backend — Environment Variables
# =====================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to Git.

# --- MongoDB Connection ---
# Option 1: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/studybuddy
#
# Option 2: MongoDB Atlas (recommended for production)
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/studybuddy?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/studybuddy

# --- Security Keys ---
# Generate strong random strings (min 32 chars).
# You can run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
JWT_SECRET_KEY=change-this-to-a-different-random-jwt-secret-key

# --- Server Settings ---
# Set to False in production
FLASK_DEBUG=False
PORT=5000

# --- CORS Allowed Origins ---
# Set to your deployed frontend URL in production
# e.g. https://studybuddy.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
